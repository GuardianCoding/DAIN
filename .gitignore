*.gguf
*.gguf.part
models/
manifest.json
SHA256SUMS

# Planning docs. The brief is circulated directly, not versioned here.
HIVE-master-brief.html
DAIN-master-brief.html
*-brief.html
RUNBOOK*

# Build output. llama.cpp is cloned beside the repo, never into it, but guard
# against it anyway — a stray build/ is hundreds of MB.
llama.cpp/
build/
*.o
*.so
*.dll
*.exe

# Benchmarks: infer/benchmarks/benchmarks.csv IS committed (INF-6, every
# number on a slide reads out of it). Scratch runs are not.
infer/benchmarks/scratch/
*.log

